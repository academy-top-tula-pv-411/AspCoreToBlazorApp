@using Microsoft.AspNetCore.Components.Web
@rendermode RenderMode.InteractiveServer

<style>
    #canvas{
        margin: 30px;
        width: 400px;
        height: 300px;
        background: gray;
    }
</style>

<div id="canvas" onclick="@ClickHandlerAsync" />
<div>
    <p>ClientX: @clientX, ClientY: @clientY</p>
    <p>OffsetX: @offsetX, OffsetY: @offsetY</p>
    <p>PageX: @pageX, PageY: @pageY</p>
    <p>ScreenX: @screenX, ScreenY: @screenY</p>
</div>

@code {
    double clientX, clientY,
                offsetX, offsetY,
                pageX, pageY,
                screenX, screenY;

    async Task ClickHandlerAsync(MouseEventArgs e)
    {
        await Task.Delay(1000);

        clientX = e.ClientX;
        clientY = e.ClientY;
        offsetX = e.OffsetX;
        offsetY = e.OffsetY;
        pageX = e.PageX;
        pageY = e.PageY;
        screenX = e.ScreenX;
        screenY = e.ScreenY;
    }
}
