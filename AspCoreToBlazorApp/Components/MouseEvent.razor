@using Microsoft.AspNetCore.Components.Web
@rendermode RenderMode.InteractiveServer

<style>
    #canvas{
        margin: 30px;
        width: 400px;
        height: 300px;
        background: gray;
    }
</style>

<div id="canvas" onmousemove="@HandlerAsync" />


@code {
    [Parameter]
    public EventCallback<MouseEventArgs> HandlerAsync { set; get; }
}
