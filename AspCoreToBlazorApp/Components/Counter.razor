@using Microsoft.AspNetCore.Components.Web
@rendermode RenderMode.InteractiveServer

<h3>Counter</h3>

<div>
    <button onclick="@Dec">Minus</button>
    <span>@Count</span>
    <button onclick="@Inc">Plus</button>
</div>

@code {
    [Parameter]
    public int? Count { set; get; } = 0;

    void Inc(MouseEventArgs e)
    {
        if (e.CtrlKey)
            Count += 10;
        else
            Count++;
    }

    void Dec() => Count--;
}
